# Identidade e ambiente
PROJECT_NAME=docprocesso
ENVIRONMENT=development
API_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Django
SECRET_KEY=change-this-development-secret-key-at-least-50-characters
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_SECURE_COOKIES=false
CSRF_TRUSTED_ORIGINS=http://localhost:8180
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:8180
MEDIA_ROOT=/data/media
DOCUMENT_MAX_UPLOAD_MB=10
DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,txt,png,jpg,jpeg

# PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_user:change-me@postgres:5432/app_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# Portas publicadas no host
ANGULAR_PORT=4300
DJANGO_PORT=8100
NGINX_PORT=8180
PGADMIN_PORT=5150

# Localização
TIMEZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br
